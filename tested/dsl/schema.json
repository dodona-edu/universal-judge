{
  "$id" : "tested:dsl:schema",
  "$schema" : "https://json-schema.org/draft/2020-12/schema",
  "title" : "TESTed-DSL",
  "oneOf" : [
    {
      "title" : "Root object of the test suite",
      "type" : "object",
      "required" : ["tabs"],
      "properties" : {
        "files" : {
          "deprecated" : true,
          "type" : "array",
          "items" : {
            "$ref" : "#/$defs/file"
          }
        },
        "namespace" : {
          "type" : "string",
          "description" : "Namespace of the submitted solution, in `snake_case`"
        },
        "tabs" : {
          "type" : "array",
          "minItems" : 1,
          "items" : {
            "$ref" : "#/$defs/tab"
          }
        },
        "language" : {
          "title" : "Programming language",
          "description" : "Indicate that all code is in a specific programming language.",
          "oneOf" : [
            {
              "$ref" : "#/$defs/programmingLanguage"
            },
            {
              "const" : "tested",
              "description" : "The TESTed-DSL specification language"
            }
          ]
        },
        "definitions" : {
          "description" : "Define hashes to use elsewhere.",
          "type" : "object"
        },
        "config" : {
          "$ref" : "#/$defs/inheritableConfigObject"
        }
      }
    },
    {
      "title" : "Tab list",
      "description" : "Shorthand for defining a list of tabs with the default options.",
      "type" : "array",
      "minItems" : 1,
      "items" : {
        "$ref" : "#/$defs/tab"
      }
    }
  ],
  "$defs" : {
    "tab" : {
      "type" : "object",
      "description" : "A tab in the test suite.",
      "required" : ["tab"],
      "properties" : {
        "files" : {
          "deprecated" : true,
          "type" : "array",
          "items" : {
            "$ref" : "#/$defs/file"
          }
        },
        "hidden" : {
          "type" : "boolean",
          "description" : "If the tab is hidden for the student or not"
        },
        "definitions" : {
          "description" : "Objects to use elsewhere.",
          "type" : "object"
        },
        "config" : {
          "description" : "Configuration options for the tab, inherited by all tests in this tab.",
          "$ref" : "#/$defs/inheritableConfigObject"
        }
      },
      "oneOf" : [
        {
          "required" : ["contexts"],
          "properties" : {
            "contexts" : {
              "description" : "The contexts in this tab.",
              "type" : "array",
              "minItems" : 1,
              "items" : {
                "$ref" : "#/$defs/context"
              }
            }
          }
        },
        {
          "required" : ["testcases"],
          "properties" : {
            "testcases" : {
              "description" : "The testcases in this tab, which will be automatically organized in contexts for you.",
              "type" : "array",
              "minItems" : 1,
              "items" : {
                "$ref" : "#/$defs/testcase"
              }
            }
          }
        }
      ]
    },
    "context" : {
      "type" : "object",
      "description" : "A set of testcase in the same context.",
      "required" : ["testcases"],
      "properties" : {
        "files" : {
          "deprecated" : true,
          "type" : "array",
          "items" : {
            "$ref" : "#/$defs/file"
          }
        },
        "context" : {
          "type" : "string",
          "description" : "Description or name of this context."
        },
        "testcases" : {
          "description" : "List of testcases in this context.",
          "type" : "array",
          "minItems" : 1,
          "items" : {
            "$ref" : "#/$defs/testcase"
          }
        }
      }
    },
    "testcase" : {
      "type" : "object",
      "description" : "An individual test for a statement or expression",
      "additionalProperties" : false,
      "properties" : {
        "description" : {
          "description" : "Override the description of this test. If not set, TESTed generates it based on its content (recommended).",
          "$ref" : "#/$defs/message"
        },
        "stdin" : {
          "description" : "Stdin for this context. Only the first testcase of a context may define stdin.",
          "oneOf" : [
            {
              "type" : [
                "string",
                "number",
                "integer",
                "boolean"
              ]
            },
            {
              "$ref" : "#/$defs/fileData"
            }
          ]
        },
        "arguments" : {
          "type" : "array",
          "description" : "Array of command line arguments for the student's submission.",
          "items" : {
            "type" : [
              "string",
              "number",
              "integer",
              "boolean"
            ]
          }
        },
        "statement" : {
          "description" : "The statement to evaluate.",
          "$ref" : "#/$defs/expressionOrStatement"
        },
        "expression" : {
          "description" : "The expression to evaluate.",
          "$ref" : "#/$defs/expressionOrStatement"
        },
        "exception" : {
          "description" : "The expected exception message.",
          "oneOf" : [
            {
              "type" : "string",
              "description" : "Message of the expected exception."
            },
            {
              "type" : "object",
              "required" : ["types"],
              "properties" : {
                "message" : {
                  "type" : "string",
                  "description" : "Message of the expected exception."
                },
                "types" : {
                  "minProperties" : 1,
                  "description" : "Language mapping of expected exception types.",
                  "type" : "object",
                  "propertyNames" : {
                    "$ref" : "#/$defs/programmingLanguage"
                  },
                  "additionalProperties" : {
                    "type" : "string"
                  }
                }
              }
            }
          ]
        },
        "files" : {
          "deprecated" : true,
          "description" : "Use input_files instead.",
          "type" : "array",
          "items" : {
            "$ref" : "#/$defs/file"
          }
        },
        "input_files" : {
          "description" : "List of files available to this test. These will be linked in the description of the test on Dodona.",
          "type" : "array",
          "items" : {
            "$ref" : "#/$defs/fileDataRequiredPath"
          }
        },
        "return" : {
          "description" : "Expected return value.",
          "$ref" : "#/$defs/returnOutputChannel"
        },
        "stderr" : {
          "description" : "Expected output on stderr.",
          "$ref" : "#/$defs/textOutputChannel"
        },
        "stdout" : {
          "description" : "Expected output on stdout.",
          "$ref" : "#/$defs/textOutputChannel"
        },
        "file" : {
          "deprecated" : true,
          "description" : "Use output_files instead.",
          "$ref" : "#/$defs/fileOutputChannel"
        },
        "output_files" : {
          "description" : "Expected files generated by the submission.",
          "$ref" : "#/$defs/fileOutputChannel"
        },
        "exit_code" : {
          "type" : "integer",
          "description" : "Expected exit code for the context. Only the last testcase of a context may define exit_code."
        }
      }
    },
    "expressionOrStatement" : {
      "oneOf" : [
        {
          "type" : "string",
          "format" : "tested-dsl-expression",
          "description" : "A statement of expression in Python-like syntax as YAML string."
        },
        {
          "description" : "Programming-language-specific statement or expression.",
          "type" : "object",
          "minProperties" : 1,
          "propertyNames" : {
            "$ref" : "#/$defs/programmingLanguage"
          },
          "additionalProperties" : {
            "type" : "string",
            "description" : "A language-specific literal, which will be used verbatim."
          }
        }
      ]
    },
    "yamlValueOrPythonExpression" : {
      "oneOf" : [
        {
          "$ref" : "#/$defs/yamlValue"
        },
        {
          "type" : "string",
          "format" : "tested-dsl-expression-value",
          "description" : "An expression in Python-syntax."
        }
      ]
    },
    "file" : {
      "deprecated" : true,
      "type" : "object",
      "description" : "Use input_files or output_files instead.",
      "required" : [
        "name",
        "url"
      ],
      "properties" : {
        "name" : {
          "type" : "string",
          "description" : "The filename, including the file extension."
        },
        "url" : {
          "type" : "string",
          "format" : "uri",
          "description" : "Relative path to the file in the `description` folder of an exercise."
        }
      }
    },
    "customCheckOracle" : {
      "type" : "object",
      "$comment" : "This only contributes properties; each usage keeps its own 'required', because they differ per channel.",
      "properties" : {
        "oracle" : {
          "const" : "custom_check"
        },
        "file" : {
          "type" : "string",
          "description" : "The path to the file containing the custom check function."
        },
        "name" : {
          "type" : "string",
          "description" : "The name of the custom check function.",
          "default" : "evaluate"
        },
        "arguments" : {
          "type" : "array",
          "description" : "List of YAML (or tagged expression) values to use as arguments to the function.",
          "items" : {
            "$ref" : "#/$defs/yamlValueOrPythonExpression"
          }
        },
        "languages" : {
          "type" : "array",
          "description" : "Which programming languages are supported by this oracle.",
          "items" : {
            "$ref" : "#/$defs/programmingLanguage"
          }
        }
      }
    },
    "textOutputChannel" : {
      "anyOf" : [
        {
          "$ref" : "#/$defs/textualType"
        },
        {
          "type" : "object",
          "description" : "Built-in oracle for text values.",
          "required" : [
            "data"
          ],
          "properties" : {
            "data" : {
              "$ref" : "#/$defs/textualType"
            },
            "oracle" : {
              "const" : "builtin"
            },
            "config" : {
              "$ref" : "#/$defs/textConfigurationOptions"
            }
          }
        },
        {
          "description" : "Custom oracle for text values.",
          "allOf" : [
            {
              "$ref" : "#/$defs/customCheckOracle"
            },
            {
              "type" : "object",
              "required" : [
                "oracle",
                "file",
                "data"
              ],
              "properties" : {
                "data" : {
                  "$ref" : "#/$defs/textualType"
                }
              }
            }
          ]
        }
      ]
    },
    "fileOutputChannel" : {
      "anyOf" : [
        {
          "type" : "object",
          "deprecated" : true,
          "description" : "Use data: instead for defining expected files.",
          "required" : [
            "content",
            "location"
          ],
          "properties" : {
            "content" : {
              "type" : "string",
              "description" : "Path to the file containing the expected contents, relative to the evaluation directory."
            },
            "location" : {
              "type" : "string",
              "description" : "Path to where the file generated by the submission should go."
            },
            "oracle" : {
              "const" : "builtin"
            },
            "config" : {
              "$ref" : "#/$defs/fileConfigurationOptions"
            }
          }
        },
        {
          "type" : "object",
          "description" : "Built-in oracle for files.",
          "required" : [
            "data"
          ],
          "properties" : {
            "data" : {
              "type" : "array",
              "description" : "Files to expect.",
              "items" : {
                "$ref" : "#/$defs/fileDataFullyRequired"
              }
            },
            "oracle" : {
              "const" : "builtin"
            },
            "config" : {
              "$ref" : "#/$defs/fileConfigurationOptions"
            }
          }
        },
        {
          "type" : "array",
          "description" : "Built-in oracle for files.",
          "items" : {
            "$ref" : "#/$defs/fileDataFullyRequired"
          }
        },
        {
          "deprecated" : true,
          "description" : "Use data to define expected files instead.",
          "allOf" : [
            {
              "$ref" : "#/$defs/customCheckOracle"
            },
            {
              "type" : "object",
              "required" : [
                "oracle",
                "content",
                "location",
                "file"
              ],
              "properties" : {
                "content" : {
                  "type" : "string",
                  "description" : "Path to the file containing the expected contents, relative to the evaluation directory."
                },
                "location" : {
                  "type" : "string",
                  "description" : "Path to where the file generated by the submission should go."
                }
              }
            }
          ]
        },
        {
          "description" : "Custom oracle for file values.",
          "allOf" : [
            {
              "$ref" : "#/$defs/customCheckOracle"
            },
            {
              "type" : "object",
              "required" : [
                "oracle",
                "data"
              ],
              "properties" : {
                "data" : {
                  "type" : "array",
                  "description" : "Files to expect.",
                  "items" : {
                    "$ref" : "#/$defs/fileDataFullyRequired"
                  }
                }
              }
            }
          ]
        }
      ]
    },
    "returnOutputChannel" : {
      "oneOf" : [
        {
          "$ref" : "#/$defs/yamlValueOrPythonExpression"
        },
        {
          "type" : "object",
          "format" : "tested-dsl-oracle",
          "additionalProperties" : false,
          "required" : [
            "value"
          ],
          "properties" : {
            "oracle" : {
              "const" : "builtin"
            },
            "value" : {
              "$ref" : "#/$defs/yamlValueOrPythonExpression"
            }
          }
        },
        {
          "description" : "Custom oracle for return values.",
          "format" : "tested-dsl-oracle",
          "unevaluatedProperties" : false,
          "allOf" : [
            {
              "$ref" : "#/$defs/customCheckOracle"
            },
            {
              "type" : "object",
              "required" : [
                "value",
                "oracle",
                "file"
              ],
              "properties" : {
                "value" : {
                  "$ref" : "#/$defs/yamlValueOrPythonExpression"
                }
              }
            }
          ]
        },
        {
          "type" : "object",
          "format" : "tested-dsl-oracle",
          "additionalProperties" : false,
          "required" : [
            "oracle",
            "functions"
          ],
          "properties" : {
            "oracle" : {
              "const" : "specific_check"
            },
            "functions" : {
              "minProperties" : 1,
              "description" : "Language mapping of oracle functions.",
              "type" : "object",
              "propertyNames" : {
                "$ref" : "#/$defs/programmingLanguage"
              },
              "additionalProperties" : {
                "type" : "object",
                "required" : [
                  "file"
                ],
                "properties" : {
                  "file" : {
                    "type" : "string",
                    "description" : "The path to the file containing the custom check function."
                  },
                  "name" : {
                    "type" : "string",
                    "description" : "The name of the custom check function.",
                    "default" : "evaluate"
                  }
                }
              }
            },
            "arguments" : {
              "minProperties" : 1,
              "description" : "Language mapping of oracle arguments.",
              "type" : "object",
              "propertyNames" : {
                "$ref" : "#/$defs/programmingLanguage"
              },
              "additionalProperties" : {
                "type" : "array",
                "description" : "List of YAML (or tagged expression) values to use as arguments to the function.",
                "items" : {
                  "type" : "string",
                  "description" : "A language-specific literal, which will be used verbatim."
                }
              }
            },
            "value" : {
              "$ref" : "#/$defs/yamlValueOrPythonExpression"
            }
          }
        }
      ]
    },
    "programmingLanguage" : {
      "type" : "string",
      "description" : "One of the programming languages supported by TESTed.",
      "enum" : [
        "bash",
        "c",
        "haskell",
        "java",
        "javascript",
        "typescript",
        "kotlin",
        "python",
        "runhaskell",
        "csharp",
        "cpp"
      ]
    },
    "message" : {
      "oneOf" : [
        {
          "type" : "string",
          "description" : "A simple message to display."
        },
        {
          "type" : "object",
          "required" : [
            "description"
          ],
          "properties" : {
            "description" : {
              "type" : "string",
              "description" : "The message to display."
            },
            "format" : {
              "type" : "string",
              "default" : "text",
              "description" : "The format of the message, either a programming language, 'text' or 'html'."
            }
          }
        }
      ]
    },
    "textConfigurationOptions" : {
      "type" : "object",
      "description" : "Configuration properties for textual comparison and to configure if the expected value should be hidden or not",
      "minProperties" : 1,
      "properties" : {
        "applyRounding" : {
          "description" : "Apply rounding when comparing as float",
          "type" : "boolean"
        },
        "caseInsensitive" : {
          "description" : "Ignore case when comparing strings",
          "type" : "boolean"
        },
        "ignoreWhitespace" : {
          "description" : "Ignore trailing whitespace",
          "type" : "boolean"
        },
        "normalizeTrailingNewlines" : {
          "description" : "Normalize trailing newlines",
          "type" : "boolean"
        },
        "roundTo" : {
          "description" : "The number of decimals to round at, when applying the rounding on floats",
          "type" : "integer"
        },
        "tryFloatingPoint" : {
          "description" : "Try comparing text as floating point numbers",
          "type" : "boolean"
        },
        "hideExpected" : {
          "description" : "Hide the expected value in feedback (default: false), not recommended to use!",
          "type" : "boolean"
        }
      }
    },
    "fileConfigurationOptions" : {
      "anyOf" : [
        {
          "$ref" : "#/$defs/textConfigurationOptions"
        },
        {
          "type" : "object",
          "properties" : {
            "mode" : {
              "type" : "string",
              "enum" : ["full", "line"],
              "default" : "full"
            }
          }
        }
      ]
    },
    "textualType" : {
      "description" : "Simple textual value, converted to string.",
      "type" : [
        "string",
        "number",
        "integer",
        "boolean"
      ]
    },
    "yamlValue" : {
      "description" : "A value represented as YAML.",
      "format" : "tested-dsl-plain-value",
      "$comment" : "Cannot be a value tagged with !oracle or !expression, and must be type-free in the JSON Schema to work"
    },
    "inheritableConfigObject" : {
      "type" : "object",
      "properties" : {
        "stdout" : {
          "$ref" : "#/$defs/textConfigurationOptions"
        },
        "stderr" : {
          "$ref" : "#/$defs/textConfigurationOptions"
        },
        "file" : {
          "$ref" : "#/$defs/fileConfigurationOptions"
        }
      }
    },
    "fileData" : {
      "type" : "object",
      "additionalProperties" : false,
      "anyOf" : [
        {
          "required" : [
            "content"
          ]
        },
        {
          "required" : [
            "path"
          ]
        }
      ],
      "properties" : {
        "content" : {
          "type" : "string",
          "description" : "Content of the file, which will be provided inline or written to disk in the workdir. If a !path, the file contents will be read from the provided path."
        },
        "path" : {
          "type" : "string",
          "description" : "Path to the file, relative to the workdir. Used to display in the output."
        }
      }
    },
    "fileDataRequiredPath" : {
      "description" : "A file where the path must be given.",
      "allOf" : [
        {
          "$ref" : "#/$defs/fileData"
        },
        {
          "required" : [
            "path"
          ]
        }
      ]
    },
    "fileDataFullyRequired" : {
      "description" : "A file where both the path and the content must be given.",
      "allOf" : [
        {
          "$ref" : "#/$defs/fileData"
        },
        {
          "required" : [
            "path",
            "content"
          ]
        }
      ]
    }
  }
}
